<idea-plugin>
    <id>com.marlzrana.heview</id>
    <name>heview</name>
    <vendor url="https://github.com/MarlzRana">marlzrana</vendor>

    <description><![CDATA[
        Leave inline code-review comments on any file, automatically injected into
        Claude Code and Codex via hooks to be resolved. JetBrains-IDE port of reviewa/heview.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Boots the per-project CommentInlayManager (editor + store listeners, pool hydration).
             CommentInlayManager itself is a light @Service(PROJECT) — no XML registration needed. -->
        <postStartupActivity implementation="com.marlzrana.heview.HeviewStartupActivity"/>
        <!-- Shared in-memory index + persistence over ~/.heview/comments. -->
        <applicationService serviceImplementation="com.marlzrana.heview.storage.CommentStore"/>
    </extensions>

    <actions>
        <action id="heview.AddComment"
                class="com.marlzrana.heview.actions.AddCommentAction"
                text="heview: Add Comment"
                description="Leave an inline review comment on the current line">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift H"/>
        </action>
    </actions>
</idea-plugin>
