<idea-plugin>
    <id>com.marlzrana.heview</id>
    <name>heview</name>
    <vendor url="https://github.com/MarlzRana">marlzrana</vendor>

    <description><![CDATA[
        Leave inline code-review comments on any file, automatically injected into
        Claude Code and Codex via hooks to be resolved. JetBrains-IDE port of reviewa/heview.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Phase 0: smoke marker confirming the plugin loads. Real features land in later phases. -->
        <postStartupActivity implementation="com.marlzrana.heview.HeviewStartupActivity"/>
    </extensions>

    <actions>
        <!-- Phase 1 spike (temporary): validates the addComponentInlay card path in a real IDE. -->
        <action id="heview.spike.AddCard"
                class="com.marlzrana.heview.spike.AddSpikeCardAction"
                text="heview: Add Spike Inlay Card"
                description="Phase 1 spike — verify addComponentInlay renders an interactive inline card">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift H"/>
        </action>
    </actions>
</idea-plugin>
